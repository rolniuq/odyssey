---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lessons = await getCollection('lessons');
const count = lessons.length;
---

<BaseLayout title="OdysseyDB — Learn PostgreSQL deeply">
  <section class="py-10 text-center">
    <p class="text-xs font-semibold tracking-widest text-indigo-500 uppercase">
      A slow, disciplined journey through the official PostgreSQL docs
    </p>
    <h1 class="mx-auto mt-4 max-w-2xl text-4xl leading-tight font-bold tracking-tight sm:text-5xl">
      One idea per page. Explain it. Prove it with a quiz.
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-lg text-slate-600">
      Based on Richard Feynman's technique — if you can&apos;t explain it simply, you don&apos;t
      understand it. Every lesson teaches one concept{' '}
      <span class="font-semibold text-slate-800">deeply</span>, with an animated diagram and a
      self-test.
    </p>
    <div class="mt-8 flex items-center justify-center gap-x-6 text-sm text-slate-500">
      <span><strong class="text-slate-800">{count}</strong> lessons so far</span>
      <span class="h-4 w-px bg-slate-300"></span>
      <span>PostgreSQL · official docs</span>
      <span class="h-4 w-px bg-slate-300"></span>
      <span>Feynman technique</span>
    </div>
    <div class="mt-8">
      <a
        href="/lessons"
        class="rounded-xl bg-indigo-600 px-6 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-indigo-700"
      >
        Start Lesson 1 →
      </a>
    </div>
  </section>

  <section class="mt-6 grid gap-4 sm:grid-cols-3">
    {
      [
        {
          n: '01',
          t: 'Teach it yourself',
          d: 'Each page is written as if explaining the idea to someone else — the core of the Feynman technique.',
        },
        {
          n: '02',
          t: 'One logic per page',
          d: 'No cramming. One concept, understood completely before you move on. Deep, not fast.',
        },
        {
          n: '03',
          t: 'Prove it',
          d: 'A quiz with instant explanations shows you why you were right — or exactly where you guessed.',
        },
      ].map((c) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <span class="text-xs font-bold text-indigo-500">{c.n}</span>
          <h2 class="mt-1 font-semibold text-slate-800">{c.t}</h2>
          <p class="mt-1 text-sm text-slate-600">{c.d}</p>
        </div>
      ))
    }
  </section>
</BaseLayout>
