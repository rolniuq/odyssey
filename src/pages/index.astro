---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lessons = await getCollection('lessons');
const count = lessons.length;
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="OdysseyDB — Learn PostgreSQL deeply"
  description="One idea per page. Explain it, prove it with a quiz. A slow, disciplined journey through the official PostgreSQL documentation."
>
  <section class="relative overflow-hidden py-14 text-center sm:py-16">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 -top-24 mx-auto h-72 w-72 rounded-full bg-indigo-500/20 blur-3xl"
    ></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-10 mx-auto h-56 w-56 rounded-full bg-violet-500/15 blur-3xl"
    ></div>

    <span
      class="relative inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-white/70 px-3 py-1 text-xs font-semibold tracking-wider text-indigo-600 uppercase dark:border-indigo-500/30 dark:bg-indigo-500/10 dark:text-indigo-300"
    >
      A slow, disciplined journey through the official PostgreSQL docs
    </span>

    <h1 class="relative mx-auto mt-6 max-w-2xl text-4xl leading-tight font-bold tracking-tight sm:text-5xl">
      One idea per page. Explain it.{' '}
      <span
        class="bg-gradient-to-r from-indigo-500 to-violet-600 bg-clip-text text-transparent"
        >Prove it with a quiz.</span
      >
    </h1>

    <p class="relative mx-auto mt-5 max-w-xl text-lg text-slate-600 dark:text-slate-300">
      Based on Richard Feynman&apos;s technique — if you can&apos;t explain it simply, you
      don&apos;t understand it. Every lesson teaches one concept{' '}
      <span class="font-semibold text-slate-800 dark:text-slate-100">deeply</span>, with an
      animated diagram and a self-test.
    </p>

    <div
      class="relative mx-auto mt-8 flex max-w-xl items-center justify-center gap-x-5 text-sm text-slate-500 dark:text-slate-400"
    >
      <span
        ><strong class="font-bold text-slate-800 dark:text-slate-100">{count}</strong> lessons so
        far</span
      >
      <span class="h-4 w-px bg-slate-300 dark:bg-slate-700"></span>
      <span>PostgreSQL · official docs</span>
      <span class="hidden h-4 w-px bg-slate-300 sm:block dark:bg-slate-700"></span>
      <span class="hidden sm:inline">Feynman technique</span>
    </div>

    <div class="relative mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href={`${base}lessons`}
        class="rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 px-6 py-3 text-base font-semibold text-white shadow-lg shadow-indigo-500/30 transition hover:from-indigo-500 hover:to-violet-500 hover:shadow-indigo-500/40"
      >
        Start Lesson 1 →
      </a>
      <a
        href="https://www.postgresql.org/docs/"
        target="_blank"
        rel="noreferrer"
        class="rounded-xl border border-slate-300 px-6 py-3 text-base font-semibold text-slate-600 transition hover:border-slate-400 hover:bg-white dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-600 dark:hover:bg-slate-900"
      >
        Read the official docs
      </a>
    </div>
  </section>

  <section class="mt-4 grid gap-4 sm:grid-cols-3">
    {
      [
        {
          n: '01',
          icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z',
          t: 'Teach it yourself',
          d: 'Each page is written as if explaining the idea to someone else — the core of the Feynman technique.',
        },
        {
          n: '02',
          icon: 'M4 6h16M4 12h16M4 18h10',
          t: 'One logic per page',
          d: 'No cramming. One concept, understood completely before you move on. Deep, not fast.',
        },
        {
          n: '03',
          icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
          t: 'Prove it',
          d: 'A quiz with instant explanations shows you why you were right — or exactly where you guessed.',
        },
      ].map((c) => (
        <div
          class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900 dark:hover:border-indigo-500/40"
        >
          <span
            class="grid h-9 w-9 place-items-center rounded-xl bg-indigo-50 text-indigo-600 transition group-hover:bg-indigo-600 group-hover:text-white dark:bg-indigo-500/10 dark:text-indigo-300 dark:group-hover:bg-indigo-600 dark:group-hover:text-white"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4.5 w-4.5">
              <path d={c.icon} />
            </svg>
          </span>
          <h2 class="mt-3 font-semibold text-slate-800 dark:text-slate-100">{c.t}</h2>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{c.d}</p>
        </div>
      ))
    }
  </section>
</BaseLayout>