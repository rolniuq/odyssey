---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lessons = await getCollection('lessons');
lessons.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Lessons — OdysseyDB">
  <div class="mb-8">
    <a href="/" class="text-sm font-medium text-indigo-600 hover:text-indigo-800">← Home</a>
    <h1 class="mt-3 text-3xl font-bold tracking-tight">The ordered path</h1>
    <p class="mt-2 max-w-2xl text-slate-600">
      One concept per page, going through the official PostgreSQL documentation in order. Learn
      deep, not fast.
    </p>
  </div>

  <ol class="space-y-3">
    {
      lessons.map((lesson, i) => (
        <li>
          <a
            href={`/lessons/${lesson.id}`}
            class="group flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-indigo-300 hover:shadow"
          >
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-sm font-bold text-slate-500 group-hover:bg-indigo-600 group-hover:text-white">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="min-w-0">
              <span class="block font-semibold text-slate-800 group-hover:text-indigo-700">
                {lesson.data.title}
              </span>
              <span class="block truncate text-sm text-slate-500">{lesson.data.coreConcept}</span>
            </span>
            <span class="ml-auto shrink-0 text-sm font-semibold text-indigo-600">→</span>
          </a>
        </li>
      ))
    }
  </ol>
</BaseLayout>
