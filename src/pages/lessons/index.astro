---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lessons = await getCollection('lessons');
lessons.sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;

const difficultyBadge: Record<string, string> = {
  beginner: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300',
  intermediate: 'bg-amber-100 text-amber-700 dark:bg-amber-500/15 dark:text-amber-300',
  advanced: 'bg-rose-100 text-rose-700 dark:bg-rose-500/15 dark:text-rose-300',
};
---

<BaseLayout
  title="Lessons — OdysseyDB"
  description="The ordered path: one concept per page through the official PostgreSQL documentation."
>
  <div class="mb-8">
    <a
      href={base}
      class="text-sm font-medium text-indigo-600 hover:text-indigo-800 dark:text-indigo-400 dark:hover:text-indigo-300"
      >← Home</a
    >
    <h1 class="mt-3 text-3xl font-bold tracking-tight">The ordered path</h1>
    <p class="mt-2 max-w-2xl text-slate-600 dark:text-slate-400">
      One concept per page, going through the official PostgreSQL documentation in order. Learn
      deep, not fast. <strong class="font-semibold text-slate-800 dark:text-slate-200"
        >{lessons.length} lessons</strong
      > so far.
    </p>
  </div>

  <ol class="space-y-3">
    {
      lessons.map((lesson, i) => (
        <li>
          <a
            href={`${base}lessons/${lesson.id}`}
            class="group flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900 dark:hover:border-indigo-500/40"
          >
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 text-sm font-bold text-white shadow-sm shadow-indigo-500/25 transition group-hover:shadow-indigo-500/40">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="min-w-0">
              <span class="block font-semibold text-slate-800 transition group-hover:text-indigo-700 dark:text-slate-100 dark:group-hover:text-indigo-300">
                {lesson.data.title}
              </span>
              <span class="block truncate text-sm text-slate-500 dark:text-slate-400">
                {lesson.data.coreConcept}
              </span>
            </span>
            <span class="ml-auto flex shrink-0 items-center gap-3">
              <span
                class={`hidden rounded-full px-2.5 py-0.5 text-xs font-semibold sm:inline-block ${difficultyBadge[lesson.data.difficulty] ?? ''}`}
              >
                {lesson.data.difficulty}
              </span>
              <span class="text-sm font-semibold text-indigo-600 transition group-hover:translate-x-1 dark:text-indigo-400">
                →
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</BaseLayout>
