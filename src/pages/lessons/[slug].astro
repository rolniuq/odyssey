---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import LessonLayout from '../../layouts/LessonLayout.astro';

// Static paths: generate one page per lesson.
export async function getStaticPaths() {
  const lessons = (await getCollection('lessons')).sort((a, b) => a.data.order - b.data.order);
  return lessons.map((lesson) => {
    const idx = lessons.findIndex((l) => l.id === lesson.id);
    return {
      params: { slug: lesson.id },
      props: {
        lesson,
        prev: idx > 0 ? lessons[idx - 1] : undefined,
        next: idx < lessons.length - 1 ? lessons[idx + 1] : undefined,
      },
    };
  });
}

interface Props {
  lesson: CollectionEntry<'lessons'>;
  prev?: CollectionEntry<'lessons'>;
  next?: CollectionEntry<'lessons'>;
}

const { lesson, prev, next } = Astro.props;
const { Content } = await render(lesson);
---

<LessonLayout lesson={lesson} prev={prev} next={next}>
  <Content />
</LessonLayout>
