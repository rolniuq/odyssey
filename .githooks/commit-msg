#!/bin/sh
# commit-msg hook — enforces the OdysseyDB commit convention (Conventional Commits).
# Installed via `git config core.hooksPath .githooks`.
set -e

msg_file="$1"
head="$(head -n 1 "$msg_file")"

# Allow merges, reverts and autosquash commits through untouched.
case "$head" in
  Merge\ * | Revert\ * | fixup!* | squash!*) exit 0 ;;
esac

if ! printf '%s' "$head" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/+-]+\))?!?: .+'; then
  echo "ERROR: commit message does not follow Conventional Commits." >&2
  echo "  format:  <type>(<scope>): <subject>" >&2
  echo "  types:   feat | fix | docs | style | refactor | perf | test | build | ci | chore | revert" >&2
  echo "  example: feat(lessons): add MVCC lesson" >&2
  echo "  see COMMIT_CONVENTION.md" >&2
  exit 1
fi

subject="${head#*: }"
if [ "${#subject}" -gt 72 ]; then
  echo "ERROR: subject is too long (${#subject} > 72 chars). Keep it short and imperative." >&2
  exit 1
fi

exit 0
